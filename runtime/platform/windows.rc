// The .exe's icon (Makefile: windres -I docs/icon). ID 1: Explorer and the taskbar use the first icon resource.
// The same Scarlet icon is used for the launcher and the game because both
// share the scarlet.exe process. Preserve the original ZA icon otherwise.
#if defined(SCARLET_AOT) && defined(SCARLET_CUSTOM_ICON)
1 ICON "scarlet.ico"
#else
1 ICON "icon.ico"
#endif
// The application manifest (RT_MANIFEST 24, ID 1): UTF-8 as the process code page - a game files folder, or LAS Recomp's
// own folder, named with non-ASCII characters wasn't found (fopen and friends read paths in the system code page)
1 24 "windows.manifest"


#ifdef SCARLET_AOT
// Scarlet release metadata, independent of the upstream ZA runtime.
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "CompanyName", "Scarlet-Recomp contributors\0"
   VALUE "FileDescription", "Scarlet-Recomp native Windows runtime\0"
   VALUE "FileVersion", "1.0.0.0\0"
   VALUE "InternalName", "Scarlet-Recomp\0"
   VALUE "ProductName", "Scarlet-Recomp\0"
   VALUE "ProductVersion", "1.0.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
#endif
